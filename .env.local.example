# Resend (https://resend.com) API key used to send contact form emails.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend for production delivery.
# Until a domain is verified, Resend only allows onboarding@resend.dev as
# the sender, and only delivers to the Resend account's own verified email.
CONTACT_FROM_EMAIL="Salonjaa Digital Solutions <notifications@salonjaadigitalsolutions.com>"

# Destination inboxes for form submissions.
CONTACT_TO_SAROJ=Sarojeditor@hotmail.com
CONTACT_TO_SNEHANJALI=snehanjalisahu515@gmail.com

# Supabase (https://supabase.com) — backs client accounts, admin-assigned
# plans/assets/domain status, payment records, and live chat.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security — server-only. Never prefix with NEXT_PUBLIC_
# and never import outside src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (https://razorpay.com) — admin-generated payment requests that
# clients pay from their account dashboard via Razorpay's hosted Checkout.
# Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
# Same value as RAZORPAY_KEY_ID, exposed to the browser for Checkout — the
# key ID isn't secret, only RAZORPAY_KEY_SECRET below is.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks, set when creating the webhook pointed
# at /api/payments/webhook. Different secret than RAZORPAY_KEY_SECRET —
# used only to verify webhook payloads, never checkout signatures.
RAZORPAY_WEBHOOK_SECRET=
